# Research Bot environment. Copy to `.env` and fill in real values.
# Never commit `.env` (it is gitignored).

# --- Environment ---------------------------------------------------------
APP_ENV=development
INTEGRATIONS_MODE=real
FAKE_LLM_CHUNK_DELAY_MS=0

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=replace-me-anthropic-api-key
# verify before deploy: check this model ID against Anthropic's current model list.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Tavily --------------------------------------------------------------
TAVILY_API_KEY=replace-me-tavily-api-key

# --- Database ------------------------------------------------------------
# In compose, DATABASE_URL is derived from the POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://research:replace-me-db-password@postgres:5432/research
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-me-db-password
POSTGRES_DB=research
# Used only by the test suite and `make e2e-stack` (dev DB from `make db-up`).
TEST_DATABASE_URL=postgresql+psycopg://research:research@127.0.0.1:5433/research_test

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-me-telegram-bot-token
# Numeric chat id of the owner; the bot ignores every other chat.
OWNER_CHAT_ID=0

# --- Owner login ---------------------------------------------------------
# Generate with: uv run python -m app.cli hash-password --compose
# The argon2 hash contains `$`. Compose interpolation treats `$` as a variable,
# so every `$` must be written as `$$` in the compose `.env` (the --compose flag does this).
OWNER_PASSWORD_HASH=replace-me-owner-password-hash
SESSION_SECRET=replace-me-session-secret
SESSION_MAX_AGE_DAYS=30
LOGIN_RATE_LIMIT_PER_MIN=5
# Comma list of proxy CIDRs whose X-Forwarded-For is trusted (web container IP in compose).
TRUSTED_PROXY_CIDRS=

# --- Public URL and binding ----------------------------------------------
# Recommended: the Tailscale MagicDNS HTTPS hostname, served by `tailscale serve`
# to 127.0.0.1:<web port>, e.g. https://research.<tailnet>.ts.net, with BIND_ADDR=127.0.0.1.
# Without `tailscale serve`, set BIND_ADDR to the VM's Tailscale IP.
# A bare http://100.x.y.z URL is rejected when APP_ENV=production (must be https).
PUBLIC_BASE_URL=https://research.your-tailnet.ts.net
BIND_ADDR=127.0.0.1
# Where the Next.js server proxies /api, /docs and /openapi.json.
API_INTERNAL_URL=http://api:8000
# 1 = serve the mock-data UI preview (no backend).
NEXT_PUBLIC_USE_MOCKS=0

# --- Worker --------------------------------------------------------------
WORKER_ENABLED=true
WORKER_TICK_SECONDS=60

# --- Run limits ----------------------------------------------------------
RUN_BUDGET_CENTS=50
RUN_MAX_SEARCH_CALLS=8
RUN_MAX_LLM_CALLS=12
LLM_MAX_TOKENS=2048
RUN_TIMEOUT_SECONDS=180
# Must be greater than RUN_TIMEOUT_SECONDS.
RUN_STALE_AFTER_SECONDS=600

# --- Prices (integer cents; placeholders, check against current pricing) --
PRICE_INPUT_CENTS_PER_MTOK=300
PRICE_OUTPUT_CENTS_PER_MTOK=1500
PRICE_SEARCH_CENTS_PER_1K=800

# --- Digest --------------------------------------------------------------
# Must be below RUN_BUDGET_CENTS.
DIGEST_SYNTH_RESERVE_CENTS=10
DIGEST_CACHE_HOURS=24
